# Copier ce fichier vers .env.local (ignoré par Git)
# Base URL côté navigateur : /api (passe par le proxy Next.js rewrites)
NEXT_PUBLIC_API_BASE_URL=/api

# Cibles serveur du proxy Next.js (next.config.ts)
# Note : Prism sert les routes sans préfixe (/events), Express les sert sous /api (/api/events).
# - Mode 100 % Prism : API_EVENTS_BASE=http://127.0.0.1:4010,     API_MOCK_BASE=http://127.0.0.1:4010
# - Mode hybride     : API_EVENTS_BASE=http://127.0.0.1:3000/api, API_MOCK_BASE=http://127.0.0.1:4010
# - Mode Back réel   : API_EVENTS_BASE=http://127.0.0.1:3000/api, API_MOCK_BASE=http://127.0.0.1:3000/api
API_EVENTS_BASE=http://127.0.0.1:3000/api
API_MOCK_BASE=http://127.0.0.1:4010
