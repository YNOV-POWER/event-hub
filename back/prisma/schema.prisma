generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PARTICIPANT
  ORGANIZER

  @@map("user_role")
}

enum EventCategory {
  CONFERENCE
  WORKSHOP
  CONCERT
  OTHER

  @@map("event_category")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED

  @@map("event_status")
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED

  @@map("registration_status")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name") @db.VarChar(80)
  role         UserRole @default(PARTICIPANT)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizedEvents Event[]
  registrations   Registration[]

  @@map("users")
}

model Event {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar(120)
  description String        @default("") @db.VarChar(5000)
  category    EventCategory
  location    String        @db.VarChar(200)
  startsAt    DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime      @map("ends_at") @db.Timestamptz(3)
  capacity    Int
  status      EventStatus   @default(DRAFT)
  organizerId String        @map("organizer_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizer     User           @relation(fields: [organizerId], references: [id])
  registrations Registration[]

  @@index([status, startsAt])
  @@index([organizerId])
  @@map("events")
}

model Registration {
  id        String             @id @default(uuid()) @db.Uuid
  eventId   String             @map("event_id") @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  status    RegistrationStatus
  position  Int?
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
  @@map("registrations")
}
