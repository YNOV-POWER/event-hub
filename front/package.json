{
  "name": "event-hub-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:mock": "node scripts/run-next-dev.mjs mock",
    "dev:back": "node scripts/run-next-dev.mjs back",
    "mock:prism": "prism mock -h 127.0.0.1 -p 4010 openapi.contract.yaml",
    "api:generate": "openapi-typescript openapi.contract.yaml -o src/api/generated/schema.d.ts",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.8",
    "@tanstack/react-query": "5.108.4",
    "i18next": "27.2.5",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@stoplight/prism-cli": "5.16.0",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/nextjs-vite": "10.6.8",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.14.0",
    "jsdom": "26.1.0",
    "msw": "3.0.7",
    "msw-storybook-addon": "3.0.3",
    "openapi-typescript": "7.13.0",
    "storybook": "10.6.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}